{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": ["node_modules", "reference"],
  "include": [".plasmo/index.d.ts", "**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "paths": {
      "~*": ["./src/*"]
    },
    "baseUrl": ".",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true
  }
}
